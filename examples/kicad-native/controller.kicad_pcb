(kicad_pcb
  (version 20241229)
  (generator "pcbnew")
  (generator_version "9.0")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (44 "Edge.Cuts" user)
  )
  (setup
    (stackup
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.53) (material "FR4") (epsilon_r 4.2))
      (layer "B.Cu" (type "copper") (thickness 0.035))
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "3V3")
  (net 3 "UART_TX")
  (footprint "Resistor_SMD:R_0603"
    (layer "F.Cu") (at 80 60)
    (property "Reference" "R1") (property "Value" "10k")
    (pad "1" smd roundrect (at 0 -0.8) (size 0.9 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd roundrect (at 0 0.8) (size 0.9 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "3V3"))
    (pad "3" smd roundrect (at 0 1.8) (size 0.9 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "UART_TX"))
  )
  (footprint "Capacitor_SMD:C_0603"
    (layer "F.Cu") (at 95 60)
    (property "Reference" "C1") (property "Value" "100nF")
    (pad "1" smd roundrect (at 0 -0.8) (size 0.9 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd roundrect (at 0 0.8) (size 0.9 0.9) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "3V3"))
  )
  (footprint "Package_QFN:QFN-32"
    (layer "F.Cu") (at 120 60)
    (property "Reference" "U1") (property "Value" "MCU")
    (pad "3" smd rect (at -1 -1) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "4" smd rect (at 1 -1) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "3V3"))
    (pad "8" smd rect (at 1 1) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "UART_TX"))
  )
  (segment (start 80 60) (end 90 60) (width 0.25) (layer "F.Cu") (net 1))
  (segment (start 95 60) (end 105 60) (width 0.25) (layer "F.Cu") (net 2))
  (arc (start 105 60) (mid 106 61) (end 107 60) (width 0.2) (layer "F.Cu") (net 3))
  (via (at 107 60) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 3))
)
